# Copy to .streamlit/secrets.toml locally, or paste into the Streamlit Cloud
# "Secrets" box for the deployed app. Never commit the real file.

[access]
password = "change-me"        # unlocks protected locations (Shinnecock, Pamunkey); omit to keep the long-standing one

[developer]
password = "change-me"        # optional: set it to put the Developer module behind a password

[github]
token  = "ghp_xxx"            # fine-grained token, Contents: read and write on the repo
repo   = "erfan-amini/adapt"
branch = "main"

[assistant]                   # the "Ask ADAPT" chat in the sidebar; absent = panel hidden
provider = "gemini"           # gemini (Google AI Studio, free, no card) | groq | openrouter | openai
api_key  = "AIza..."          # Google AI Studio: https://aistudio.google.com/apikey
model    = ""                 # optional; empty = a Gemini Flash model is picked automatically
base_url = ""                 # openai provider only, e.g. https://api.groq.com/openai/v1
